  "name": "\"mode\": \"Indexed\" \"policyRule\"",
  "display_name": "Enforce VM Encryption",
  "comment": "\"description\": \"This policy ensures that all Azure virtual machines have encryption enabled.\"",
  "provider": "Azure",
  "provider_detail": "Microsoft.Authorization/policyDefinitions",
  "operator": "AND",
  "condition_raw": "{\n  \"mode\": \"Indexed\",\n  \"displayName\": \"Enforce VM Encryption\",\n  \"description\": \"This policy ensures that all Azure virtual machines have encryption enabled.\",\n  \"policyRule\": {\n    \"if\": {\n      \"allOf\": [\n        {\n          \"field\": \"type\",\n          \"equals\": \"Microsoft.Compute/virtualMachines\"\n        },\n        {\n          \"not\": {\n            \"field\": \"Microsoft.Compute/virtualMachines/storageProfile.osDisk.encryptionSettings.enabled\",\n            \"equals\": true\n          }\n        }\n      ]\n    },\n    \"then\": {\n      \"effect\": \"audit\",\n      \"details\": {\n        \"type\": \"Microsoft.Compute/virtualMachines\",\n        \"name\": \"Virtual Machines without encryption enabled\",\n        \"message\": \"Encryption is not enabled for virtual machine {field('name')}.\",\n        \"severity\": \"Critical\"\n      }\n    }\n  },\n  \"parameters\": {}\n}\n",
  "condition_cel": null,
  "condition_json": null,
  "condition_origin": "json",
